{
  "name": "lan-signage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "fixtures": "tsx --env-file-if-exists=.env scripts/fixtures.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:ui": "tsx scripts/redesign-check.ts",
    "test:features": "tsx scripts/feature-e2e.ts",
    "test:keepawake": "tsx scripts/keepawake-e2e.ts",
    "test:release": "tsx scripts/release-e2e.ts",
    "license": "tsx licensing/vendor.ts",
    "release": "tsx licensing/build-release.ts"
  },
  "dependencies": {
    "@spectrum-web-components/button": "^1.12.6",
    "@spectrum-web-components/progress-bar": "^1.12.6",
    "@spectrum-web-components/status-light": "^1.12.6",
    "@spectrum-web-components/theme": "^1.12.6",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
